	column time_to_settle_days =
			
			IF( fct_claim[status] = "Closed",
			    DATEDIFF(fct_claim[report_date], fct_claim[close_date], DAY),
			    BLANK()
			)
		formatString: 0
		lineageTag: 05cb8ccc-6539-4952-af8a-323faf5875b3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column open_claim_age_days =
			
			IF(
			    fct_claim[status] = "Open",
			    DATEDIFF(fct_claim[report_date], [Valuation Date], DAY)
			)
		formatString: 0
		lineageTag: d6b7ff0a-a494-496a-90f6-6e84f86e7411
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition fct_claim = m
		mode: import
		source =
				let
				    Conn = PostgresMartsConnection,
				    Source = PostgreSQL.Database(Conn[Server], Conn[Database], [Query = "SELECT * FROM marts.fct_claim"])
				in
				    Source

